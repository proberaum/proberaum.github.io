---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import { Code } from 'astro-expressive-code/components';
import Base from '../../../layouts/Base.astro';
import PluginSidebar from '../../../components/PluginSidebar.astro';
import { plugins, STATUS_LABEL, ROLE_LABEL, installSnippet, githubUrl, npmUrl, type Plugin } from '../../../data/plugins';

export const getStaticPaths = (() => plugins.map(plugin => ({ params: { id: plugin.id }, props: { plugin } }))) satisfies GetStaticPaths;

interface Props {
  plugin: Plugin;
}

const { plugin } = Astro.props;
const entries = await getCollection('docs', entry => entry.data.workspace === plugin.id);
const readmeEntry = entries.find(e => e.data.kind === 'readme');
const docEntries = entries.filter(e => e.data.kind === 'doc').sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const readme = readmeEntry ? await render(readmeEntry) : undefined;
const packages = await Promise.all(
  plugin.packages.map(async pkg => {
    const entry = entries.find(e => e.data.kind === 'package' && e.data.package === pkg.dir);
    // Skip package READMEs that just repeat the workspace README.
    const duplicate = entry && readmeEntry && entry.body?.trim() === readmeEntry.body?.trim();
    return { pkg, entry, content: entry && !duplicate ? await render(entry) : undefined };
  }),
);

// Only show screenshots in the gallery that are not already embedded in a README.
const renderedMarkdown = [readmeEntry, ...packages.map(p => (p.content ? p.entry : undefined))]
  .map(e => e?.body ?? '')
  .join('\n');
const gallery = plugin.screenshots.filter(s => !renderedMarkdown.includes(s.src));
---

<Base title={plugin.title} description={plugin.description}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/#plugins">Plugins</a>
      <span aria-hidden="true">/</span>
      <span>{plugin.title}</span>
    </nav>

    <header class="plugin-header">
      <div class="plugin-emoji" aria-hidden="true">{plugin.emoji}</div>
      <div>
        <h1>{plugin.title}</h1>
        <p class="lead">{plugin.description}</p>
        <p class="status-line">
          <span class:list={['badge', `status-${plugin.status}`]}>{STATUS_LABEL[plugin.status]}</span>
          {plugin.statusNote && <span class="muted">{plugin.statusNote}</span>}
        </p>
      </div>
    </header>

    <div class="layout">
      <div class="content">
        {
          gallery.length > 0 && (
            <section>
              <h2 class="section-title">Screenshots</h2>
              <div class="gallery">
                {gallery.map(shot => (
                  <a href={shot.src} class="shot">
                    <img src={shot.src} alt={shot.alt} loading="lazy" />
                  </a>
                ))}
              </div>
            </section>
          )
        }

        {
          readme && (
            <section>
              <h2 class="section-title">Overview</h2>
              <div class="prose">
                <readme.Content />
              </div>
            </section>
          )
        }

        {
          docEntries.length > 0 && (
            <section>
              <h2 class="section-title">Documentation</h2>
              <ul class="doc-links">
                {docEntries.map(doc => (
                  <li>
                    <a href={`/plugins/${plugin.id}/docs/${doc.data.slug}/`}>
                      <span>{doc.data.title}</span>
                      <span aria-hidden="true">→</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <section>
          <h2 class="section-title">Packages</h2>
          {
            packages.map(({ pkg, content }) => (
              <article class="package" id={`pkg-${pkg.dir}`}>
                <header class="package-header">
                  <h3>
                    <a href={`#pkg-${pkg.dir}`}>
                      <code>{pkg.name}</code>
                    </a>
                  </h3>
                  <div class="package-meta">
                    {pkg.role && <span class="chip">{ROLE_LABEL[pkg.role] ?? pkg.role}</span>}
                    {pkg.published ? (
                      <a class="chip" href={npmUrl(pkg.name)}>
                        npm v{pkg.version}
                      </a>
                    ) : (
                      <span class="chip">not published yet</span>
                    )}
                    <a class="chip" href={githubUrl(pkg.path)}>
                      source
                    </a>
                  </div>
                </header>
                {pkg.description && <p class="muted">{pkg.description}</p>}

                {pkg.published && (
                  <div class="install">
                    <h4>Installation</h4>
                    {installSnippet(pkg).map(snippet => (
                      <Code code={snippet.code} lang={snippet.lang} title={snippet.title} />
                    ))}
                  </div>
                )}

                {content && (
                  <details class="readme" open={plugin.packages.length <= 2}>
                    <summary>README</summary>
                    <div class="prose">
                      <content.Content />
                    </div>
                  </details>
                )}
              </article>
            ))
          }
        </section>
      </div>

      <PluginSidebar plugin={plugin} docs={docEntries.map(d => ({ slug: d.data.slug!, title: d.data.title }))} />
    </div>
  </div>
</Base>

<style>
  .breadcrumbs {
    display: flex;
    gap: 0.5rem;
    margin: 1.5rem 0 1rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .breadcrumbs a {
    color: var(--text-muted);
  }

  .plugin-header {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .plugin-emoji {
    flex: none;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    font-size: 2rem;
    border-radius: 1rem;
    background: var(--accent-soft);
  }

  h1 {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .lead {
    margin: 0.5rem 0 0;
    max-width: 65ch;
    font-size: 1.0625rem;
    color: var(--text-muted);
  }

  .status-line {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem;
    margin: 0.875rem 0 0;
    font-size: 0.875rem;
  }

  @media (max-width: 560px) {
    .plugin-emoji {
      width: 48px;
      height: 48px;
      font-size: 1.5rem;
    }
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
    margin-top: 2rem;
  }

  @media (min-width: 960px) {
    .layout {
      grid-template-columns: minmax(0, 1fr) 260px;
    }
  }

  .content > section + section {
    margin-top: 3rem;
  }

  .section-title {
    margin: 0 0 1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .gallery {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 360px), 1fr));
  }

  .shot {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--bg-subtle);
  }

  .shot img {
    display: block;
    width: 100%;
  }

  .doc-links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }

  .doc-links a {
    display: flex;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    background: var(--bg-elevated);
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }

  .doc-links a:hover {
    border-color: var(--accent);
  }

  .package {
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elevated);
    scroll-margin-top: 80px;
  }

  .package + .package {
    margin-top: 1rem;
  }

  .package-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .package-header h3 {
    margin: 0;
    font-size: 0.9375rem;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .package-header h3 a {
    color: var(--text);
    text-decoration: none;
  }

  .package-header h3 a:hover {
    color: var(--accent-text);
  }

  .package-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .chip {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  a.chip:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .package > .muted {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
  }

  .install {
    margin-top: 1rem;
  }

  .install h4 {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
  }

  .install :global(.expressive-code + .expressive-code) {
    margin-top: 0.75rem;
  }

  .readme {
    margin-top: 1rem;
    border-top: 1px solid var(--border);
    padding-top: 0.75rem;
  }

  .readme summary {
    cursor: pointer;
    font-weight: 600;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .readme[open] summary {
    margin-bottom: 1rem;
  }
</style>
